// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingPageConfig {
  id                  String   @id @default(cuid())
  primaryColor        String   @default("#000000") // This is button background
  formTitle           String   @default("Ready to Deliver?")
  formSubtitle        String   @default("Fill out the form below and we'll handle the rest.")
  formButtonText      String   @default("Submit Request")
  formBackgroundColor String   @default("#ffffff")
  formTextColor       String   @default("#111827")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DeliveryRequest {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  phone       String
  destination String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompletedDelivery {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  phone       String
  destination String
  createdAt   DateTime
  completedAt DateTime @default(now())
}

model CancelledDelivery {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  phone       String
  destination String
  createdAt   DateTime
  cancelledAt DateTime @default(now())
}

model GalleryImage {
  id          String   @id @default(cuid())
  imageUrl    String
  caption     String?
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
